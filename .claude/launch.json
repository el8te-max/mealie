{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PRODUCTION=false",
        "uv",
        "run",
        "python",
        "mealie/app.py"
      ],
      "port": 9000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "run",
        "dev",
        "--no-fork"
      ],
      "port": 3000
    }
  ]
}